{
  "name": "@yanjijinxiao/agent-bridge",
  "version": "0.6.5",
  "private": true,
  "workspaces": [
    "taskboard"
  ],
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "description": "Connect messaging channels to agents through device Connectors. Supports Codex App Server and Herdr TUI/App.",
  "license": "MIT",
  "author": "Xuechao Zou",
  "contributors": [
    "yanjijinxiao"
  ],
  "homepage": "https://github.com/yanjijinxiao/agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/yanjijinxiao/agent-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanjijinxiao/agent-bridge.git"
  },
  "keywords": [
    "codex",
    "wechat",
    "weixin",
    "dingtalk",
    "feishu",
    "wecom",
    "gateway",
    "im",
    "openai",
    "bridge"
  ],
  "type": "module",
  "scripts": {
    "install:local": "node scripts/install-local.mjs",
    "install:check": "node scripts/install-local.mjs --check",
    "build": "npm run build:bridge && npm run build:taskboard",
    "build:bridge": "node scripts/prepare-build.mjs && tsc -p tsconfig.json && npm run copy:web",
    "build:taskboard": "npm run build:web --workspace=codex-taskboard && node scripts/package-taskboard-runtime.mjs",
    "copy:web": "node scripts/copy-web-assets.mjs",
    "clean": "node -e \"const fs=require('fs'); for (const dir of ['dist','taskboard/dist']) fs.rmSync(dir,{recursive:true,force:true})\"",
    "dev": "tsx src/server/index.ts",
    "dev:taskboard": "npm run dev --workspace=codex-taskboard",
    "taskboard:check": "npm run check --workspace=codex-taskboard",
    "taskboard:codex": "npm run codex --workspace=codex-taskboard",
    "taskboard:inject": "npm run codex:inject --workspace=codex-taskboard",
    "taskboard:start": "npm run start --workspace=codex-taskboard",
    "taskboard:taskctl": "npm run taskctl --workspace=codex-taskboard --",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=4 --test-timeout=120000 --import tsx test/*.test.ts",
    "peer": "node dist/peer/index.js",
    "peer:dev": "tsx src/peer/index.ts",
    "package:npm": "node scripts/package-npm.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "dependencies": {
    "@alicloud/dingtalk": "^2.2.46",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "dingtalk-stream": "^2.1.6-beta.1",
    "dompurify": "^3.4.12",
    "lucide": "^0.468.0",
    "marked": "^18.0.6",
    "open": "^10.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "bin": {
    "agent-bridge": "dist/server/index.js",
    "agent-bridge-connector": "dist/peer/index.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
